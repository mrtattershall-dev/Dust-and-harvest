{
  "name": "skyai-skyblock",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An AI teammate that plays Skyblock with you on a Minecraft Bedrock server",
  "scripts": {
    "setup": "node server/setup.mjs",
    "start": "node server/run.mjs",
    "verify": "node server/verify.mjs",
    "package": "mkdir -p dist && git archive --format=zip --prefix=skyai-teammate/ -o dist/skyai-teammate.zip HEAD",
    "typecheck": "tsc -p addon/tsconfig.json"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0"
  },
  "devDependencies": {
    "@minecraft/server": "2.12.0-beta.1.26.65-stable",
    "@minecraft/server-admin": "1.0.0-beta.1.26.65-stable",
    "@minecraft/server-gametest": "1.0.0-beta.1.26.65-stable",
    "@minecraft/server-net": "1.0.0-beta.1.26.65-stable",
    "typescript": "^5.6.0"
  }
}
